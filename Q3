Create a class named Calculator.
Create two attributes: num1 and num2.
Create methods for: Addition, Subtraction, Multiplication, Division.
Create an object and call all methods.


class Calculator:
    def __init__(self, num1, num2):
        self.num1 = num1
        self.num2 = num2

    def addition(self):
        return self.num1 + self.num2

    def subtraction(self):
        return self.num1 - self.num2

    def multiplication(self):
        return self.num1 * self.num2

    def division(self):
        if self.num2 == 0:
            return "Error: Cannot divide by zero"
        return self.num1 / self.num2


calc = Calculator(20, 5)
print("Addition:", calc.addition())
print("Subtraction:", calc.subtraction())
print("Multiplication:", calc.multiplication())
print("Division:", calc.division())
